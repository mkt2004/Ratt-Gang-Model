    "dataset = VideoDataset(\n",
    "    video_paths=video_paths,\n",
    "    labels=labels,\n",
    "    num_frames=16,\n",
    ")\n",
    "\n",
    "loader = DataLoader(\n",
    "    dataset,\n",
    "    batch_size=8,\n",
    "    shuffle=True,\n",
    "    num_workers=4,\n",
    ")\n",
    "\n",
    "videos, labels = next(iter(loader))\n",
    "\n",
    "print(videos.shape)  # [8, 16, 3, 224, 224]\n",
    "print(labels.shape)  # [8]"
   ]
